{
  "name": "Energy Forecast Infrastructure",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "api",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "forwardPorts": [8000, 5000, 9090, 3001],
  "postCreateCommand": "pip install -e .[serving]"
}