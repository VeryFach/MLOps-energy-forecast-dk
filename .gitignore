# Virtual environment
.venv/
venv/
env/

# Python cache & build
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Downloaded data (reproducible via fetch scripts)
# Full raw dumps are git-ignored; sample + timestamped example are kept for tugas submission
data/raw/*
!data/raw/.gitkeep
!data/raw/sample_*.csv
!data/raw/sample_*.json
!data/raw/sample_*.parquet
data/processed/*
!data/processed/.gitkeep
!data/processed/sample_*.csv

# Trained models (reproducible via training scripts)
models/*
!models/.gitkeep

# Logs & monitoring artifacts
logs/*
!logs/.gitkeep

# Prefect
.prefect/
*.pid

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Notebook (personal insight / eksplorasi)
notebook/*
!notebook/.gitkeep

# image
image/*
!image/.gitkeep

# Personal notes (docs/info.md)
/docs/info.md

# Helper commit scripts
scripts/commit_to_main.sh
scripts/commit_to_main.ps1
scripts/create_eksperimen.sh