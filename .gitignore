# Virtual environment
.venv/
venv/
env/

# Python cache & build
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Downloaded data (reproducible via fetch scripts)
# Full raw dumps are git-ignored; sample + timestamped example are kept for tugas submission
# Ignore seluruh dataset mentah
data/raw/*

# Tetap izinkan metadata DVC dan .gitignore
!data/raw/*.dvc
!data/raw/.gitignore
!data/raw/.gitkeep

# Ignore dataset hasil pemrosesan
data/processed/*

# Tetap izinkan metadata DVC
!data/processed/*.dvc
!data/processed/.gitignore
!data/processed/.gitkeep

# Trained models (reproducible via training scripts)
models/*
!models/.gitkeep

# Local MLflow tracking store and temporary browser profile
mlflow.db
mlruns/
.edge-mlflow/

# Logs & monitoring artifacts
logs/*
!logs/.gitkeep

# Prefect
.prefect/
*.pid

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Notebook (personal insight / eksplorasi)
notebook/*
!notebook/.gitkeep

# image
image/*
!image/.gitkeep

# Dokumen baru tetap lokal; file docs yang sudah dilacak Git tetap dilacak
/docs/*
!/docs/.gitkeep

# Skrip pribadi baru tetap lokal; skrip yang sudah dilacak Git tetap dilacak
/scripts/*
