# Virtual environment
.venv/
venv/
env/

# Python cache & build
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Downloaded data (reproducible via fetch scripts)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Trained models (reproducible via training scripts)
models/*
!models/.gitkeep

# Logs & monitoring artifacts
logs/*
!logs/.gitkeep

# Prefect
.prefect/
*.pid

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Notebook (personal insight / eksplorasi)
notebook/*
!notebook/.gitkeep

# image
image/*
!image/.gitkeep

# Personal notes (docs/info.md)
/docs/info.md